{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/tools",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noai, noimageai"
        }
      ]
    },
    {
      "source": "/tools.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noai, noimageai"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://surveys-three-sage.vercel.app/_next/:path*"
    },
    {
      "source": "/api/surveys/:path*",
      "destination": "https://surveys-three-sage.vercel.app/api/surveys/:path*"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]+[a-z0-9])",
      "destination": "https://surveys-three-sage.vercel.app/:slug"
    }
  ]
}
